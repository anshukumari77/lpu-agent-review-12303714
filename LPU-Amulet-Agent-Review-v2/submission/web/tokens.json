{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "An Operate surface with a selected-screen stage, explicit capture controls and scoped evidence.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.176, 0.204, 0.212],
        "hex": "#2d3436"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.125, 0.149, 0.157],
        "hex": "#202628"
      }
    },
    "pink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.42, 0.616],
        "hex": "#ff6b9d"
      }
    },
    "magenta": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.851, 0.29, 0.557],
        "hex": "#d94a8e"
      }
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.992, 0.976],
        "hex": "#fffdf9"
      }
    },
    "warm": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.965, 0.953, 0.937],
        "hex": "#f6f3ef"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.349, 0.376, 0.392],
        "hex": "#596064"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.867, 0.863, 0.843],
        "hex": "#dddcd7"
      }
    },
    "blush": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.941, 0.961],
        "hex": "#fff0f5"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 7,
        "unit": "px"
      }
    },
    "frame": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 620,
        "letterSpacing": {
          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 620,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "evidence": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
